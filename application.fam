# For details & more options, see documentation/AppManifests.md in firmware repo

App(
    appid="loratalk",  # Must be unique
    name="LoRa Talk",  # Displayed in menus
    apptype=FlipperAppType.EXTERNAL,
    entry_point="loratalk_app",
    stack_size=4 * 1024,
    requires=["gui", "storage", "notification"],
    # tests/ and tools/ are built for the PC / Arduino, not the Flipper
    sources=["*.c", "!tests", "!tools"],
    fap_category="Sub-GHz",
    fap_version="1.0",
    fap_icon="loratalk.png",  # 10x10 1-bit PNG
    fap_description="Text chat over a REYAX RYLR998 LoRa module connected to the GPIO UART",
    fap_author="patr1k",
    fap_weburl="https://github.com/patr1k/loratalk",
    fap_icon_assets="images",  # Image assets to compile for this application
)
